{
  "name": "wahalao-template-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "submit": "bash scripts/submit_template_contribution.sh",
